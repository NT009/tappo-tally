# Database Connection
# The connection string for your MongoDB database instance
MONGODB_URI=""

# Better Auth Configuration
# A secure, random secret key used by Better Auth to encrypt session data and tokens
# You can generate one using: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The base URL of your application used by Better Auth on the server-side
# Typically http://localhost:3000 for local development
BETTER_AUTH_URL=
# The base URL of your application exposed to the client-side/browser
# Needs to match BETTER_AUTH_URL for the client to make requests to the auth endpoints
NEXT_PUBLIC_BETTER_AUTH_URL=
